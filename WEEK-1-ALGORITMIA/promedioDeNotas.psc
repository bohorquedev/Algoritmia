Algoritmo promedioDeNotas
	Definir nota1, nota2, nota3, promedioNotas Como Real
	Escribir 'Digita nota numero 1: '
	Leer nota1
	Escribir 'Digita nota numero 2: '
	Leer nota2
	Escribir 'Digita nota numero 3: '
	Leer nota3
	promedioNotas <- (nota1+nota2+nota3)/3
	Escribir 'Tu promedio de notas es: ', promedioNotas
FinAlgoritmo
